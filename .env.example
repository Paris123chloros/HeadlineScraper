# Docker settings. Attach the existing Ollama container using the documented alias.
OLLAMA_NETWORK=motorsport-ai
OLLAMA_BASE_URL=http://motorsport-ollama:11434
OLLAMA_MODEL=qwen3.5-instruct:4b
OLLAMA_TIMEOUT_SECONDS=5
REPORT_TIMEZONE=Europe/Athens
LOG_LEVEL=INFO
DASHBOARD_PORT=8000
# Docker sets DATA_DIR=/data; native development defaults to ./data.
