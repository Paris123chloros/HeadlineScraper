# Docker Desktop connects to the existing native Windows Ollama app.
# Odysseus remains a separate interface and is not managed by this project.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5-instruct:4b
OLLAMA_TIMEOUT_SECONDS=5
REPORT_TIMEZONE=Europe/Athens
LOG_LEVEL=INFO
DASHBOARD_PORT=8000
# Docker sets DATA_DIR=/data; native development defaults to ./data.
# Native collection defaults to config/sources.yaml; Compose uses /app/config/sources.yaml.
